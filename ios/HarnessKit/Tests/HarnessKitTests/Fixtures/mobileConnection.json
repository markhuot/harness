{
  "describeErrorCases": [
    {
      "name": "api 401",
      "input": {
        "error": {
          "kind": "api",
          "status": 401,
          "message": "unauthorized"
        }
      },
      "output": "The service rejected the token (401). Show the pairing QR code on the Mac again and rescan it."
    },
    {
      "name": "api 401 with no message",
      "input": {
        "error": {
          "kind": "api",
          "status": 401,
          "message": ""
        }
      },
      "output": "The service rejected the token (401). Show the pairing QR code on the Mac again and rescan it."
    },
    {
      "name": "api 403 keeps its message",
      "input": {
        "error": {
          "kind": "api",
          "status": 403,
          "message": "Forbidden here"
        }
      },
      "output": "Forbidden here"
    },
    {
      "name": "api 409",
      "input": {
        "error": {
          "kind": "api",
          "status": 409,
          "message": "Key taken"
        }
      },
      "output": "Key taken"
    },
    {
      "name": "api 500 with no message",
      "input": {
        "error": {
          "kind": "api",
          "status": 500,
          "message": ""
        }
      },
      "output": "HTTP 500"
    },
    {
      "name": "api message naming a network failure is still the api message",
      "input": {
        "error": {
          "kind": "api",
          "status": 502,
          "message": "Network request failed"
        },
        "baseUrl": "http://h:1"
      },
      "output": "Network request failed"
    },
    {
      "name": "network request failed with base",
      "input": {
        "error": {
          "kind": "error",
          "message": "Network request failed"
        },
        "baseUrl": "http://h:1"
      },
      "output": "Couldn't reach h:1. Check that the Mac is awake and on the same network or tailnet, and that Harness → Settings → Network lets the service listen beyond localhost."
    },
    {
      "name": "network request failed without base",
      "input": {
        "error": {
          "kind": "error",
          "message": "Network request failed"
        }
      },
      "output": "Couldn't reach the service."
    },
    {
      "name": "network request failed with empty base",
      "input": {
        "error": {
          "kind": "error",
          "message": "Network request failed"
        },
        "baseUrl": ""
      },
      "output": "Couldn't reach the service."
    },
    {
      "name": "failed to fetch",
      "input": {
        "error": {
          "kind": "error",
          "message": "TypeError: Failed to fetch"
        },
        "baseUrl": "https://mac.local/harness"
      },
      "output": "Couldn't reach mac.local/harness. Check that the Mac is awake and on the same network or tailnet, and that Harness → Settings → Network lets the service listen beyond localhost."
    },
    {
      "name": "could not connect",
      "input": {
        "error": {
          "kind": "error",
          "message": "Could not connect to the server."
        },
        "baseUrl": "http://100.64.0.2:7717"
      },
      "output": "Couldn't reach 100.64.0.2:7717. Check that the Mac is awake and on the same network or tailnet, and that Harness → Settings → Network lets the service listen beyond localhost."
    },
    {
      "name": "load failed",
      "input": {
        "error": {
          "kind": "error",
          "message": "Load failed"
        }
      },
      "output": "Couldn't reach the service."
    },
    {
      "name": "upper case",
      "input": {
        "error": {
          "kind": "error",
          "message": "NETWORK REQUEST FAILED"
        }
      },
      "output": "Couldn't reach the service."
    },
    {
      "name": "other message",
      "input": {
        "error": {
          "kind": "error",
          "message": "boom"
        }
      },
      "output": "boom"
    },
    {
      "name": "empty message",
      "input": {
        "error": {
          "kind": "error",
          "message": ""
        }
      },
      "output": ""
    },
    {
      "name": "near miss",
      "input": {
        "error": {
          "kind": "error",
          "message": "network request"
        }
      },
      "output": "network request"
    }
  ],
  "isUnauthorizedCases": [
    {
      "name": "api 401",
      "input": {
        "kind": "api",
        "status": 401,
        "message": "x"
      },
      "output": true
    },
    {
      "name": "api 403",
      "input": {
        "kind": "api",
        "status": 403,
        "message": "x"
      },
      "output": false
    },
    {
      "name": "plain error mentioning 401",
      "input": {
        "kind": "error",
        "message": "401"
      },
      "output": false
    }
  ],
