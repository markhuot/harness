  "themeLinkPrefsCases": [
    {
      "name": "takes valid picks and appearance",
      "input": {
        "darkTheme": "catppuccin-mocha",
        "lightTheme": "rose-pine-dawn",
        "theme": "dark"
      },
      "output": {
        "lightTheme": "rose-pine-dawn",
        "darkTheme": "catppuccin-mocha",
        "theme": "dark"
      }
    },
    {
      "name": "drops unknown ids, wrong-appearance ids and bad appearances",
      "input": {
        "darkTheme": "one-light",
        "lightTheme": "nope",
        "theme": "sepia"
      },
      "output": {}
    },
    {
      "name": "drops repeated params (arrays)",
      "input": {
        "darkTheme": [
          "dracula",
          "nord"
        ]
      },
      "output": {}
    },
    {
      "name": "nothing",
      "input": {},
      "output": {}
    },
    {
      "name": "empty values are dropped",
      "input": {
        "darkTheme": "",
        "lightTheme": "",
        "theme": ""
      },
      "output": {}
    },
    {
      "name": "only the appearance",
      "input": {
        "theme": "system"
      },
      "output": {
        "theme": "system"
      }
    },
    {
      "name": "upper-case appearance is dropped",
      "input": {
        "theme": "Light"
      },
      "output": {}
    },
    {
      "name": "unrelated params are ignored",
      "input": {
        "tab": "appearance",
        "lightTheme": "github-light"
      },
      "output": {
        "lightTheme": "github-light"
      }
    },
    {
      "name": "a dark id is not a light pick",
      "input": {
        "lightTheme": "dracula"
      },
      "output": {}
    }
  ],
