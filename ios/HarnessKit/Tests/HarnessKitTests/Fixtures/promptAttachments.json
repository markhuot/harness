      "output": "folder"
    },
    {
      "name": "no slash",
      "input": "shot.png",
      "output": "shot.png"
    },
    {
      "name": "root",
      "input": "/",
      "output": ""
    },
    {
      "name": "spaces",
      "input": "/Users/me/My Notes/a b.txt",
      "output": "a b.txt"
    }
  ],
