{
  "addPromptAttachmentsCases": [
    {
      "name": "appends in order",
      "input": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "added": [
          {
            "path": "/Users/me/notes.pdf"
          },
          {
            "path": "/Users/me/.harness/uploads/u1/Pasted image.png",
            "name": "Pasted image.png",
            "source": "upload"
          }
        ]
      },
      "output": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          },
          {
            "path": "/Users/me/notes.pdf",
            "name": "notes.pdf",
            "source": "file"
          },
          {
            "path": "/Users/me/.harness/uploads/u1/Pasted image.png",
            "name": "Pasted image.png",
            "source": "upload"
          }
        ],
        "skipped": 0
      }
    },
    {
      "name": "a path already attached is skipped",
      "input": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "added": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "again"
          }
        ]
      },
      "output": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "skipped": 0
      }
    },
    {
      "name": "a path twice in one add is attached once",
      "input": {
        "list": [],
        "added": [
          {
            "path": "/x.png"
          },
          {
            "path": "/x.png"
          }
        ]
      },
      "output": {
        "list": [
          {
            "path": "/x.png",
            "name": "x.png",
            "source": "file"
          }
        ],
        "skipped": 0
      }
    },
    {
      "name": "the limit leaves the rest out",
      "input": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          },
          {
            "path": "/Users/me/notes.pdf",
            "name": "notes.pdf",
            "source": "file"
          }
        ],
        "added": [
          {
            "path": "/1.png"
          },
          {
            "path": "/2.png"
          },
          {
            "path": "/3.png"
          }
        ],
        "max": 3
      },
      "output": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          },
          {
            "path": "/Users/me/notes.pdf",
            "name": "notes.pdf",
            "source": "file"
          },
          {
            "path": "/1.png",
            "name": "1.png",
            "source": "file"
          }
        ],
        "skipped": 2
      }
    },
    {
      "name": "a duplicate past the limit isn't counted as skipped",
      "input": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "added": [
          {
            "path": "/Users/me/Desktop/shot.png"
          },
          {
            "path": "/2.png"
          }
        ],
        "max": 1
      },
      "output": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "skipped": 1
      }
    },
    {
      "name": "nothing added",
      "input": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "added": []
      },
      "output": {
        "list": [
          {
            "path": "/Users/me/Desktop/shot.png",
            "name": "shot.png",
            "source": "file"
          }
        ],
        "skipped": 0
      }
    }
  ],
  "fileBaseNameCases": [
    {
      "name": "a file",
      "input": "/a/b/shot.png",
      "output": "shot.png"
    },
    {
      "name": "a trailing slash",
