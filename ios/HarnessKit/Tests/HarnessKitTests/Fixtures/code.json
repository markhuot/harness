{
  "codeKindCases": [
    {
      "name": "diff fence",
      "input": {
        "fence": "diff",
        "text": "just words"
      },
      "output": "diff"
    },
    {
      "name": "patch fence",
      "input": {
        "fence": "patch",
        "text": "+a"
