      "output": "diff"
    },
    {
      "name": "untagged hunk",
      "input": {
        "fence": "",
        "text": "@@ -1,2 +1,2 @@\n-a\n+b"
      },
      "output": "diff"
    },
    {
      "name": "untagged header pair",
      "input": {
        "fence": "",
        "text": "--- a/x.ts\n+++ b/x.ts\n-a\n+b"
      },
      "output": "diff"
    },
    {
      "name": "untagged diff --git",
      "input": {
        "fence": "",
        "text": "diff --git a/x b/x\nindex 1..2"
      },
      "output": "diff"
    },
    {
      "name": "tagged language wins",
      "input": {
        "fence": "ts",
        "text": "@@ -1,2 +1,2 @@\n-a\n+b"
      },
      "output": "code"
    },
    {
      "name": "udiff fence",
      "input": {
