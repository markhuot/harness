{
  "parseTemplateCases": [
    {
      "name": "unclosed if on line 2",
      "input": "a\n{{#if x}}b",
      "output": {
        "error": "Line 2: {{#if x}} is never closed with {{/if}}"
      }
    },
    {
      "name": "stray /if",
      "input": "{{/if}}",
      "output": {
        "error": "Line 1: {{/if}} without an open {{#if}}"
      }
    },
    {
      "name": "stray else",
      "input": "{{else}}",
      "output": {
        "error": "Line 1: {{else}} without an open {{#if}}"
      }
    },
    {
      "name": "stray else if",
      "input": "{{else if y}}",
      "output": {
        "error": "Line 1: {{else if y}} without an open {{#if}}"
      }
    },
    {
      "name": "second else",
      "input": "{{#if x}}a{{else}}b{{else}}c{{/if}}",
      "output": {
        "error": "Line 1: a second {{else}} in the same {{#if}}"
      }
    },
    {
      "name": "else if after else",
      "input": "{{#if x}}a{{else}}b{{else if y}}c{{/if}}",
      "output": {
        "error": "Line 1: {{else if y}} after {{else}}"
      }
    },
    {
      "name": "extra /if",
      "input": "{{#if x}}{{/if}}{{/if}}",
      "output": {
        "error": "Line 1: {{/if}} without an open {{#if}}"
      }
    },
    {
      "name": "unclosed braces",
      "input": "hi {{name",
      "output": {
        "error": "Line 1: \"{{\" is never closed with \"}}\""
      }
    },
    {
      "name": "each is not a tag",
      "input": "{{#each items}}",
      "output": {
        "error": "Line 1: {{#each items}} isn't a template tag (use {{name}}, {{#if name}}, {{else}}, {{else if name}} or {{/if}})"
      }
    },
    {
      "name": "two words",
      "input": "{{two words}}",
      "output": {
        "error": "Line 1: {{two words}} isn't a template tag (use {{name}}, {{#if name}}, {{else}}, {{else if name}} or {{/if}})"
      }
    },
    {
      "name": "empty tag",
      "input": "{{}}",
      "output": {
        "error": "Line 1: {{}} isn't a template tag (use {{name}}, {{#if name}}, {{else}}, {{else if name}} or {{/if}})"
      }
    },
    {
      "name": "bad variable name",
      "input": "{{#if 1x}}{{/if}}",
      "output": {
        "error": "Line 1: \"1x\" in {{#if 1x}} isn't a variable name"
      }
    },
    {
      "name": "if without a name",
      "input": "{{#if}}{{/if}}",
      "output": {
        "error": "Line 1: {{#if}} isn't a template tag (use {{name}}, {{#if name}}, {{else}}, {{else if name}} or {{/if}})"
      }
    },
    {
      "name": "nested else-if chain still needs the outer /if",
      "input": "{{#if a}}{{#if b}}x{{else if c}}y{{/if}}",
      "output": {
        "error": "Line 1: {{#if a}} is never closed with {{/if}}"
      }
    },
    {
      "name": "nested else-if chain closed",
      "input": "{{#if a}}{{#if b}}x{{else if c}}y{{/if}}{{/if}}",
      "output": {
        "ok": [
          {
            "type": "if",
            "name": "a",
            "then": [
              {
                "type": "if",
                "name": "b",
                "then": [
                  {
                    "type": "text",
                    "text": "x"
                  }
                ],
                "else": [
                  {
                    "type": "if",
                    "name": "c",
                    "then": [
                      {
                        "type": "text",
                        "text": "y"
                      }
                    ],
                    "else": []
                  }
                ]
              }
            ],
            "else": []
          }
        ]
      }
    },
    {
      "name": "empty",
      "input": "",
      "output": {
        "ok": []
      }
    },
    {
      "name": "text only",
      "input": "Hello\nworld",
      "output": {
        "ok": [
          {
            "type": "text",
            "text": "Hello\nworld"
          }
        ]
      }
    },
    {
      "name": "single braces",
      "input": "`browser_open` { url } {x}",
      "output": {
        "ok": [
          {
            "type": "text",
            "text": "`browser_open` { url } {x}"
          }
        ]
      }
    },
    {
      "name": "variable with padding",
      "input": "Hi {{ name }},\n  {{n}} left ",
      "output": {
        "ok": [
          {
            "type": "text",
            "text": "Hi "
          },
          {
            "type": "var",
            "name": "name"
          },
          {
            "type": "text",
            "text": ",\n  "
          },
          {
            "type": "var",
            "name": "n"
          },
          {
            "type": "text",
            "text": " left "
          }
        ]
      }
    },
    {
      "name": "full chain",
      "input": "[{{#if a}}A{{else if b}}B{{else if c}}C{{else}}D{{/if}}]",
      "output": {
        "ok": [
          {
            "type": "text",
            "text": "["
          },
          {
            "type": "if",
            "name": "a",
            "then": [
              {
                "type": "text",
                "text": "A"
              }
            ],
            "else": [
              {
                "type": "if",
                "name": "b",
                "then": [
                  {
                    "type": "text",
                    "text": "B"
                  }
                ],
                "else": [
                  {
                    "type": "if",
                    "name": "c",
                    "then": [
                      {
                        "type": "text",
                        "text": "C"
                      }
                    ],
                    "else": [
                      {
                        "type": "text",
                        "text": "D"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "text": "]"
          }
        ]
      }
    },
    {
      "name": "nested",
      "input": "{{#if a}}{{#if b}}ab{{else}}a{{/if}}!{{else}}{{#if b}}b{{/if}}-{{/if}}",
      "output": {
        "ok": [
          {
            "type": "if",
            "name": "a",
            "then": [
              {
                "type": "if",
                "name": "b",
                "then": [
                  {
                    "type": "text",
                    "text": "ab"
                  }
                ],
                "else": [
                  {
                    "type": "text",
                    "text": "a"
                  }
                ]
              },
              {
                "type": "text",
                "text": "!"
              }
            ],
            "else": [
              {
                "type": "if",
                "name": "b",
                "then": [
                  {
                    "type": "text",
                    "text": "b"
                  }
                ],
                "else": []
              },
              {
                "type": "text",
                "text": "-"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "tab and newline inside tags",
      "input": "{{#if\ta}}x{{else\n if\tb}}y{{/if}}",
      "output": {
        "ok": [
          {
            "type": "if",
            "name": "a",
            "then": [
              {
                "type": "text",
                "text": "x"
              }
            ],
            "else": [
              {
                "type": "if",
                "name": "b",
                "then": [
                  {
                    "type": "text",
                    "text": "y"
                  }
                ],
                "else": []
              }
            ]
          }
        ]
      }
    },
    {
      "name": "NBSP padding is trimmed",
      "input": "{{ x }}",
      "output": {
        "ok": [
          {
            "type": "var",
            "name": "x"
          }
        ]
      }
    },
    {
      "name": "underscore names",
      "input": "{{_}}{{a_1}}{{_B}}",
