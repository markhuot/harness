  "renderTemplateCases": [
    {
      "name": "substitutes and copies text exactly",
      "input": {
        "template": "Hi {{name}},\n  {{ n }} left ",
        "vars": {
          "name": "Ada",
          "n": 3
        }
      },
      "output": {
        "ok": "Hi Ada,\n  3 left "
      }
    },
    {
      "name": "if string",
      "input": {
