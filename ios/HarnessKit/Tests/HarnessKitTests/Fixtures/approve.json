  "primaryApproveRequestCases": [
    {
      "name": "the preselected pr",
      "input": {
        "opts": {
          "actions": [
            "merge",
            "pr",
            "cleanup",
            "custom"
          ],
          "defaultAction": "pr",
          "parentBranch": null
        },
        "ticket": {}
      },
      "output": {
        "via": "review",
        "body": {
          "decision": "approve",
          "action": "pr"
        }
      }
    },
    {
      "name": "a child on its parent's branch merges",
      "input": {
        "opts": {
          "actions": [
            "merge"
          ],
          "defaultAction": "merge",
          "parentBranch": "harness/web-1"
        },
        "ticket": {
          "completionAction": "pr"
        }
      },
      "output": {
        "via": "review",
        "body": {
          "decision": "approve",
          "action": "merge"
        }
      }
    },
    {
      "name": "a custom re-approval keeps its instructions",
      "input": {
        "opts": {
          "actions": [
            "merge",
