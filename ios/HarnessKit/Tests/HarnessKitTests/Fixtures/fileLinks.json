{
  "formatFileLinkCases": [
    {
      "name": "range",
      "input": {
        "path": "src/app.ts",
        "startLine": 102,
        "endLine": 115
      },
      "output": "harness://file/src/app.ts#L102-L115"
    },
    {
      "name": "reversed range",
      "input": {
        "path": "src/app.ts",
        "startLine": 115,
        "endLine": 102
      },
      "output": "harness://file/src/app.ts#L102-L115"
    },
    {
      "name": "one-line range",
      "input": {
        "path": "src/app.ts",
        "startLine": 9,
        "endLine": 9
      },
      "output": "harness://file/src/app.ts#L9"
    },
    {
      "name": "no range",
      "input": {
        "path": "src/app.ts"
      },
      "output": "harness://file/src/app.ts"
    },
    {
      "name": "encoded segments and params",
      "input": {
        "path": "my dir/a#b?.ts",
        "ticketKey": "HARNESS-12",
        "projectId": "p 1"
      },
      "output": "harness://file/my%20dir/a%23b%3F.ts?ticket=HARNESS-12&project=p%201"
    },
    {
      "name": "absolute",
      "input": {
        "path": "/Users/me/x.ts",
        "startLine": 1
      },
      "output": "harness://file//Users/me/x.ts#L1"
    },
    {
      "name": "empty segments dropped",
      "input": {
        "path": "/a//b/",
        "ticketKey": ""
      },
      "output": "harness://file//a/b"
    },
    {
      "name": "project only",
      "input": {
        "path": "a.ts",
        "projectId": "p&q"
      },
      "output": "harness://file/a.ts?project=p%26q"
    },
    {
      "name": "line zero is no range",
      "input": {
        "path": "a.ts",
        "startLine": 0,
        "endLine": 5
      },
      "output": "harness://file/a.ts"
    },
    {
      "name": "end without start",
      "input": {
        "path": "a.ts",
        "endLine": 5
      },
      "output": "harness://file/a.ts"
    },
    {
      "name": "end zero",
      "input": {
        "path": "a.ts",
        "startLine": 5,
        "endLine": 0
      },
      "output": "harness://file/a.ts#L5"
    },
    {
      "name": "negative start",
      "input": {
        "path": "a.ts",
        "startLine": -3
      },
      "output": "harness://file/a.ts#L-3"
    },
    {
      "name": "unicode",
      "input": {
        "path": "über/naïve.ts"
      },
      "output": "harness://file/%C3%BCber/na%C3%AFve.ts"
    }
  ],
