  "permissionModeLabels": {
    "auto": {
      "label": "Auto",
      "description": "A classifier approves routine actions and asks you about risky ones."
    },
    "ask": {
      "label": "Ask",
      "description": "Edits inside the working directory run; everything else asks you first."
    },
    "read_only": {
      "label": "Read only",
      "description": "The agent can read and run read-only commands, but can't change anything."
    }
