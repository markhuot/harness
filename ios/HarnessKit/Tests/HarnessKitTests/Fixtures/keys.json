      "input": "A",
      "output": {
        "key": "A",
        "error": null
      }
    },
    {
      "name": "sixteen characters",
      "input": "AAAAAAAAAAAAAAAA",
      "output": {
        "key": "AAAAAAAAAAAAAAAA",
        "error": null
      }
    },
    {
      "name": "seventeen characters",
      "input": "AAAAAAAAAAAAAAAAA",
      "output": {
        "key": "AAAAAAAAAAAAAAAAA",
