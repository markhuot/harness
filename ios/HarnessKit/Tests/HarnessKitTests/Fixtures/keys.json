      "input": "3D",
      "output": {
        "key": "3D",
        "error": "Must start with a letter"
      }
    },
    {
      "name": "dash inside",
      "input": "MY-APP",
      "output": {
        "key": "MY-APP",
        "error": "Letters and digits only"
      }
    },
    {
      "name": "underscore",
      "input": "A_B",
      "output": {
        "key": "A_B",
        "error": "Letters and digits only"
      }
    },
    {
      "name": "non-ASCII letter",
      "input": "CAFÉ",
      "output": {
        "key": "CAFÉ",
        "error": "Letters and digits only"
      }
    },
    {
      "name": "reserved",
      "input": "triage",
      "output": {
        "key": "TRIAGE",
        "error": "TRIAGE is reserved"
      }
    },
    {
      "name": "reserved with whitespace",
      "input": " Triage ",
      "output": {
        "key": "TRIAGE",
        "error": "TRIAGE is reserved"
      }
    },
    {
      "name": "reserved as a prefix is fine",
      "input": "TRIAGE2",
      "output": {
        "key": "TRIAGE2",
        "error": null
      }
    }
