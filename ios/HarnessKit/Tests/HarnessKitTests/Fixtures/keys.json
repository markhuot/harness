  "isTicketKeyCases": [
    {
      "name": "valid",
      "input": "hel-1",
      "output": true
    },
    {
      "name": "invalid",
      "input": "hel",
      "output": false
    }
  ],
  "keyedCases": [
    {
      "name": "unlinked",
      "input": {
        "key": "MH-62",
        "externalRef": null
      },
      "output": {
        "displayKey": "MH-62",
        "secondaryKey": null,
        "keyLabel": "MH-62",
        "isLegacyMirror": false
      }
    },
    {
      "name": "no externalRef field",
      "input": {
        "key": "MH-62"
      },
      "output": {
        "displayKey": "MH-62",
        "secondaryKey": null,
        "keyLabel": "MH-62",
        "isLegacyMirror": false
      }
    },
    {
      "name": "linked",
      "input": {
        "key": "MH-124",
        "externalRef": {
          "key": "MH-62"
        }
      },
      "output": {
        "displayKey": "MH-62",
        "secondaryKey": "MH-124",
        "keyLabel": "MH-62 · MH-124",
        "isLegacyMirror": false
      }
    },
    {
      "name": "legacy mirror",
      "input": {
        "key": "CEPFR-12",
        "externalRef": {
          "key": "CEPFR-12"
        }
      },
      "output": {
        "displayKey": "CEPFR-12",
        "secondaryKey": null,
        "keyLabel": "CEPFR-12",
        "isLegacyMirror": true
      }
    },
    {
      "name": "empty remote key falls back",
      "input": {
        "key": "MH-5",
        "externalRef": {
          "key": ""
        }
      },
      "output": {
        "displayKey": "MH-5",
        "secondaryKey": null,
        "keyLabel": "MH-5",
        "isLegacyMirror": false
      }
    },
    {
      "name": "canonically equivalent but different keys",
      "input": {
        "key": "É-1",
        "externalRef": {
          "key": "É-1"
        }
      },
      "output": {
        "displayKey": "É-1",
        "secondaryKey": "É-1",
        "keyLabel": "É-1 · É-1",
        "isLegacyMirror": false
      }
    }
  ],
