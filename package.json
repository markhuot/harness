{
  "name": "harness",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "service", "app", "ios", "release", "plugins/*"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "service": "bun run service/src/daemon.ts",
    "app": "bun run --cwd app dev",
    "typecheck": "bunx tsc -p service --noEmit && bunx tsc -p app --noEmit && bunx tsc -p plugins --noEmit && bunx tsc -p plugins/tsconfig.server.json --noEmit && bunx tsc -p ios --noEmit && bunx tsc -p release --noEmit",
    "plugins:build": "bun run --filter '@harness/plugin-*' build",
    "sim": "bun ios/Tools/sim.ts",
    "release:prepare": "bun release/release.ts prepare",
    "release:publish": "release/publish-install.sh"
  },
  "trustedDependencies": ["electron"]
}
