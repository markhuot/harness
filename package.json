{
  "name": "harness",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "service", "app", "mobile", "plugins/*"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "service": "bun run service/src/daemon.ts",
    "app": "bun run --cwd app dev",
    "typecheck": "bunx tsc -p service --noEmit && bunx tsc -p app --noEmit && bunx tsc -p plugins --noEmit && bunx tsc -p plugins/tsconfig.server.json --noEmit && bunx tsc -p mobile --noEmit",
    "plugins:build": "bun run --filter '@harness/plugin-*' build",
    "release:prepare": "bun mobile/Tools/release.ts prepare",
    "release:publish": "mobile/Tools/publish-install.sh"
  },
  "trustedDependencies": ["electron"]
}
