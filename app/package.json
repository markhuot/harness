{
  "name": "@harness/app",
  "productName": "Harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && electron .",
    "mock": "bun scripts/mock-service.ts",
    "package": "bun run build && bun scripts/package.ts",
    "install-app": "bun run build && bun scripts/package.ts --checkout && bun scripts/sign-mac.ts --local && bun scripts/install-app.ts",
    "install-app:bundled": "bun run package && bun scripts/sign-mac.ts --local && bun scripts/install-app.ts",
    "test": "bun test src scripts",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "shoot": "bun run build && bun scripts/shoot.ts",
    "real": "bun run build && bun scripts/real-service.ts",
    "changes": "bun run build && bun scripts/changes.ts",
    "spec-activity": "bun run build && bun scripts/spec-activity.ts",
    "browser-tabs": "bun run build && bun scripts/browser-tabs.ts",
    "spec-headings": "bun run build && bun scripts/spec-headings-check.ts",
    "browser-size": "bun run build && bun scripts/browser-size-check.ts",
    "icon": "bun scripts/icon.ts",
    "typecheck": "tsc --noEmit -p .",
    "sign-mac": "bun scripts/sign-mac.ts"
  },
  "dependencies": {
    "@harness/shared": "workspace:*",
    "@pierre/diffs": "^1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "ghostty-web": "0.4.0-next.20.g1858a59",
    "node-pty": "^1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@electron/packager": "^18.3.6",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
