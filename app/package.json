{
  "name": "@harness/app",
  "productName": "Harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && electron .",
    "mock": "bun scripts/mock-service.ts",
    "package": "bun run build && bun scripts/package.ts",
    "install-app": "bun run package && bun scripts/install-app.ts",
    "test": "bun test src",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "shoot": "bun run build && bun scripts/shoot.ts",
    "real": "bun run build && bun scripts/real-service.ts",
    "changes": "bun run build && bun scripts/changes.ts",
    "icon": "bun scripts/icon.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@harness/shared": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "trustedDependencies": ["electron"]
}
