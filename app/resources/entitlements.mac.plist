<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V8 needs these under the hardened runtime (Developer ID + notarization). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- The App Group the desktop widget shares with the app (src/main/widgets.ts writes where the
	     service is into it). Team-prefixed, so a Developer ID app needs no provisioning profile,
	     and holding it keeps macOS from asking before the app writes into the group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>47P4ZSALX4.com.markhuot.harness</string>
	</array>
</dict>
</plist>
