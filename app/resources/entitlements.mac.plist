<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- V8 needs these under the hardened runtime (Developer ID + notarization). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Push notifications (APNs). A restricted entitlement: the app only launches with it when the
	     provisioning profile embedded at Contents/embedded.provisionprofile grants it, along with
	     this application identifier and team, to the signing certificate (scripts/profile.ts
	     checks all of that before sign-mac.ts signs). One App ID, and so one APNs topic, for the
	     Mac, iPhone and iPad apps. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>com.apple.application-identifier</key>
	<string>47P4ZSALX4.com.markhuot.harness</string>
	<key>com.apple.developer.team-identifier</key>
	<string>47P4ZSALX4</string>
	<!-- The App Group the desktop widget shares with the app (src/main/widgets.ts writes where the
	     service is into it). Team-prefixed, which the profile allows (47P4ZSALX4.*), and holding
	     it keeps macOS from asking before the app writes into the group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>47P4ZSALX4.com.markhuot.harness</string>
	</array>
</dict>
</plist>
